{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Monitor Dashboard Run Metrics 0.x",
  "type": "object",
  "required": ["schema_version", "monitor_key"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.[0-9]+$" },
    "monitor_key": { "type": "string", "minLength": 1 },
    "run_number": { "type": ["integer", "null"] },
    "dry_run": { "type": ["boolean", "null"] },
    "final_publications": { "type": ["integer", "null"] }
  },
  "additionalProperties": true
}
