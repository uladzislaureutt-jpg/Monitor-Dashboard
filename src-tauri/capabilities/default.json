{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Monitor Dashboard main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-read-text"
  ]
}
