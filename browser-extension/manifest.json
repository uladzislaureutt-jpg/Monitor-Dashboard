{
  "manifest_version": 3,
  "name": "Monitor Browser Import",
  "version": "0.1.0",
  "description": "Передаёт открытую публикацию в Desktop Monitor.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:17842/*"],
  "action": {
    "default_title": "Передать в Monitor",
    "default_popup": "popup.html"
  }
}
